{
  "manifest_version": 3,
  "name": "Nexame — Assistente de estudos",
  "version": "2.0.5",
  "description": "Atualiza seu desempenho nas plataformas de questões e ajusta automaticamente seu plano de estudos no Nexame.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nexame — Assistente de estudos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "host_permissions": [
    "https://www.tecconcursos.com.br/*",
    "https://tecconcursos.com.br/*",
    "https://asmeduardo.github.io/estudos-concursos/*",
    "https://www.qconcursos.com/*",
    "https://qconcursos.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.tecconcursos.com.br/*", "https://tecconcursos.com.br/*", "https://www.qconcursos.com/*", "https://qconcursos.com/*", "https://asmeduardo.github.io/estudos-concursos/*"],
      "js": ["adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
